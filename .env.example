# ===== 必需 =====
GITHUB_TOKEN=
AI_API_KEY=

# ===== 选哪个大模型（只写这一行就能切，默认 deepseek）=====
# deepseek    → api.deepseek.com / deepseek-chat（便宜稳定）
# zhipu       → open.bigmodel.cn / glm-4.5-flash（免费，适合个人用）
# zhipu-pro   → open.bigmodel.cn / glm-4.6（付费，效果更好）
# qwen        → dashscope 兼容模式 / qwen-plus
# AI_PROVIDER=deepseek

# ===== 需要时可单独覆盖预设 =====
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4.5-flash

# ===== 限流与缓存（一般不用改）=====
# AI_RATE_LIMIT=20
# CACHE_TTL=300
# AI_TIMEOUT=90
