# ===== 必需 =====
GITHUB_TOKEN=
AI_API_KEY=

# ===== 选哪个大模型（只写这一行就能切，默认 deepseek）=====
# deepseek    → api.deepseek.com / deepseek-chat（便宜稳定）
# zhipu       → open.bigmodel.cn / glm-4.7-flash（免费，200K 上下文）
# zhipu-lite  → open.bigmodel.cn / glm-4.5-flash（免费，128K）
# zhipu-pro   → open.bigmodel.cn / glm-4.6（付费）
# qwen        → dashscope 兼容模式 / qwen-plus
# AI_PROVIDER=deepseek

# ===== 需要时可单独覆盖预设 =====
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4.7-flash

# ===== 行为参数（一般不用改）=====
# 推理类模型（glm-4.5/4.6/4.7）关掉思考，速度更快、不浪费 token
# AI_DISABLE_THINKING=1
# 免费档偶发「访问量过大」，自动重试次数
# AI_RETRY=2
# AI_RATE_LIMIT=20
# AI_TIMEOUT=120
# CACHE_TTL=300
